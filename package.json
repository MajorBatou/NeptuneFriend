{
  "name": "neptunefriend",
  "version": "1.0.0",
  "private": true,
  "workspaces": ["apps/*"],
  "scripts": {
    "dev:web": "npm -w apps/web run dev",
    "dev:api": "npm -w apps/api run dev",
    "build:web": "npm -w apps/web run build",
    "build:api": "npm -w apps/api run build",
    "lint": "npm -w apps/web run lint && npm -w apps/api run lint",
    "test": "npm -w apps/web run test && npm -w apps/api run test",
    "format": "prettier --write \"apps/**/*.{ts,tsx,js,json,css,md}\""
  },
  "devDependencies": {
    "prettier": "^3.2.5",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2"
  },
  "lint-staged": {
    "apps/**/*.{ts,tsx,js}": ["eslint --fix", "prettier --write"],
    "apps/**/*.{json,css,md}": ["prettier --write"]
  }
}
